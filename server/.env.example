# ============================================================
# QuickShow Server — Environment Variables
# Copy this file to .env and fill in your actual values.
# These must be set as system environment variables before
# starting Tomcat, OR configured inside setenv.sh / setenv.bat.
# ============================================================

# --- SQL Server ---
# JDBC URL for your SQL Server instance.
# trustServerCertificate=true is convenient for local dev; remove for production.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=QuickShow;encrypt=true;trustServerCertificate=true

# SQL Server login credentials
DB_USER=sa
DB_PASSWORD=123

# --- JWT Authentication ---
# Secret key for signing HS256 JWTs. Must be at least 32 characters.
JWT_SECRET=your_super_secret_key_at_least_32_chars

# --- TMDB ---
# Your TMDB API key (v3 auth).
# Register at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=184b815cba0a3a114ad07b4a582b639c

# --- CORS ---
# The URL of your React client (used for Access-Control-Allow-Origin).
CLIENT_URL=http://localhost:5173
